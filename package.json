{
  "name": "bare-ggwave",
  "version": "0.0.0",
  "description": "Data over sound for Bare, native ggwave bindings with custom protocols",
  "main": "index.js",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "package.json",
    "NOTICE",
    "index.js",
    "index.d.ts",
    "binding.cc",
    "binding.js",
    "CMakeLists.txt",
    "prebuilds"
  ],
  "addon": true,
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "brittle-bare test/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-ggwave.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-ggwave/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-ggwave#readme",
  "devDependencies": {
    "brittle": "^3.19.0",
    "cmake-bare": "^1.8.0",
    "cmake-fetch": "^1.0.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}
